{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.investment-support-agent/contracts/agent_output.schema.json",
  "title": "Analysis agent output bundle",
  "type": "object",
  "required": ["schema_version", "target_id", "report_date", "agent_outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "agent_outputs_bundle_v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "report_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "agent_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agentOutput" }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "agentOutput": {
      "type": "object",
      "required": ["schema_version", "agent_name", "run_id", "stance", "conclusion", "claim_strength", "confidence", "evidence_ids", "key_points", "limitations"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "agent_output_v1" },
        "agent_name": {
          "type": "string",
          "enum": ["bull", "bear", "contradiction", "pricing"]
        },
        "run_id": { "type": "string", "minLength": 1 },
        "stance": { "type": "string", "minLength": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "claim_strength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "key_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
