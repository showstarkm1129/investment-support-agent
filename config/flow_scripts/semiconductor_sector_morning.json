{
  "schema_version": "flow_script_v1",
  "script_id": "semiconductor_sector_morning",
  "display_name": "半導体セクター朝サーチ",
  "description": "日本株と米国株をまたぐ半導体セクターの朝用サーチ。需給、決算、設備投資、AI需要、規制、為替、指数反応をEvidence化して整理する。",
  "flow": "morning_report",
  "provider": "codex",
  "model": "default",
  "mode": "simulate",
  "depth": "normal",
  "execution": {
    "type": "cli"
  },
  "timezone": "Asia/Tokyo",
  "target": {
    "target_id": "SECTOR-SEMICONDUCTOR",
    "target_type": "sector",
    "stock_code": "",
    "company_name": "半導体セクター",
    "market": "JP-US-watchlist",
    "themes": ["半導体", "生成AI", "データセンター", "装置", "メモリ", "規制"],
    "auto_report_enabled": true,
    "watchlist": [
      {"ticker": "8035", "name": "東京エレクトロン", "market": "TSE"},
      {"ticker": "6857", "name": "アドバンテスト", "market": "TSE"},
      {"ticker": "6920", "name": "レーザーテック", "market": "TSE"},
      {"ticker": "6146", "name": "ディスコ", "market": "TSE"},
      {"ticker": "NVDA", "name": "NVIDIA", "market": "US"},
      {"ticker": "AMD", "name": "Advanced Micro Devices", "market": "US"},
      {"ticker": "TSM", "name": "TSMC", "market": "US"},
      {"ticker": "ASML", "name": "ASML", "market": "US"}
    ]
  },
  "variables": {
    "sector": "半導体",
    "region": "JP-US",
    "lookback_hours": 24,
    "focus_questions": [
      "AI需要とデータセンター投資に変化はあるか",
      "半導体製造装置とメモリで温度差はあるか",
      "米国時間の株価反応は日本株に波及しそうか",
      "輸出規制、為替、金利が逆風になっていないか"
    ]
  },
  "agent_groups": [
    {
      "group_id": "search_plan",
      "parallel": false,
      "agents": ["search_design"]
    },
    {
      "group_id": "collect_inputs",
      "parallel": true,
      "agents": ["connector:jquants", "connector:ir", "connector:news", "connector:macro_policy"]
    },
    {
      "group_id": "build_evidence",
      "parallel": false,
      "agents": ["evidence_builder"]
    },
    {
      "group_id": "analysis",
      "parallel": true,
      "agents": ["bull", "bear", "contradiction", "pricing"]
    },
    {
      "group_id": "judge",
      "parallel": false,
      "agents": ["report_judge", "health"]
    }
  ],
  "agents": [
    {
      "agent_id": "search_design",
      "inputs": ["target.watchlist", "variables.focus_questions", "flows/morning_report.md"],
      "outputs": ["runs/{date}/{target_id}/morning/search_plan.json"],
      "notes": ["半導体指数、主要米国株、国内装置株、政策ニュースの優先順位を決める。"]
    },
    {
      "agent_id": "connector:jquants",
      "inputs": ["search_plan.json", "target.watchlist"],
      "outputs": ["data/raw/jquants/{run_id}.json", "data/normalized/prices/{run_id}.json"],
      "notes": ["国内対象銘柄の前日終値、出来高、指数比較を取得対象にする。"]
    },
    {
      "agent_id": "connector:ir",
      "inputs": ["search_plan.json", "target.watchlist"],
      "outputs": ["data/raw/ir/{run_id}.json"],
      "notes": ["決算、月次、受注、設備投資、説明会資料を優先する。"]
    },
    {
      "agent_id": "connector:news",
      "inputs": ["search_plan.json", "target.watchlist"],
      "outputs": ["data/raw/news/{run_id}.json"],
      "notes": ["一次情報、主要媒体、規制・供給網ニュースを優先する。"]
    },
    {
      "agent_id": "connector:macro_policy",
      "inputs": ["search_plan.json"],
      "outputs": ["data/raw/macro_policy/{run_id}.json"],
      "notes": ["為替、金利、米中規制、補助金、輸出管理を対象にする。"]
    },
    {
      "agent_id": "evidence_builder",
      "inputs": ["data/raw/**/{run_id}.json", "contracts/evidence.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/evidence.json"],
      "notes": ["価格反応とニュース本文を混同せず、Evidence IDを付ける。"]
    },
    {
      "agent_id": "bull",
      "inputs": ["evidence.json", "contracts/agent_output.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/agent_outputs.json"],
      "notes": ["強気材料だけでなく、強さの根拠と時間軸を明示する。"]
    },
    {
      "agent_id": "bear",
      "inputs": ["evidence.json", "contracts/agent_output.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/agent_outputs.json"],
      "notes": ["需要鈍化、規制、在庫、バリュエーション、為替を確認する。"]
    },
    {
      "agent_id": "contradiction",
      "inputs": ["evidence.json", "contracts/agent_output.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/agent_outputs.json"],
      "notes": ["人気テーマに反する材料やデータの食い違いを探す。"]
    },
    {
      "agent_id": "pricing",
      "inputs": ["evidence.json", "price_volume", "contracts/agent_output.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/agent_outputs.json"],
      "notes": ["SOX、NASDAQ、主要米国株、国内装置株の反応から織り込みを評価する。"]
    },
    {
      "agent_id": "report_judge",
      "inputs": ["evidence.json", "agent_outputs.json", "contracts/report_judge.schema.json"],
      "outputs": ["runs/{date}/{target_id}/morning/report_judge.json"],
      "notes": ["売買指示を出さず、情報状態と見方が変わる条件をまとめる。"]
    },
    {
      "agent_id": "health",
      "inputs": ["manifest.json", "context.json", "expected outputs"],
      "outputs": ["runs/{date}/{target_id}/morning/health.json"],
      "notes": ["不足情報、schema未検証、手動確認が必要な箇所を記録する。"]
    }
  ],
  "outputs": ["markdown", "html", "notebooklm"],
  "automation": {
    "eligible": true,
    "default_route": "morning_search",
    "recommended_time": "07:00"
  }
}
