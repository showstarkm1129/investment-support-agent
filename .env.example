# Copy to .env and fill only the providers you actually use.

# LLM/API providers used by scripts/run_flow.py --provider *_api
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Market and disclosure data providers
# J-Quants API V2 uses API key authentication. Create/copy the key from:
# https://jpx-jquants.com/ja/dashboard/api-keys
JQUANTS_API_KEY=
EDINET_API_KEY=

# Optional news/search providers
NEWS_API_KEY=
